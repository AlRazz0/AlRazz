{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alrazz",
  "account_id": "0f2584e6ebbd78b3662bd09be7c2d98a",
  "workers_dev": true,
  "main": "server/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alrazz-db",
      "database_id": "488b5a1c-dea7-4603-a2ca-8682e92e0955",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_PASSWORD_VERIFIER",
        "class_name": "AdminPasswordVerifier",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-admin-password-verifier",
      "new_sqlite_classes": ["AdminPasswordVerifier"],
    },
  ],
  "observability": { "enabled": true },
}
